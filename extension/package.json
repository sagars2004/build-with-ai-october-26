{
  "name": "explainit-extension",
  "displayName": "Explainit",
  "description": "A playful code comprehension quiz for AI-assisted development.",
  "version": "0.1.0",
  "publisher": "explainit",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "explainit.explainThisChange",
        "title": "Explain This Change"
      },
      {
        "command": "explainit.explainThisChangeLive",
        "title": "Explain This Change — MCP Agent"
      }
    ],
    "chatParticipants": [
      {
        "id": "explainit.host",
        "name": "explainit",
        "description": "Let the Explainit game-show host observe your coding prompt and call out what to watch."
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./tsconfig.json",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "package": "npm run compile && vsce package --no-dependencies --out ../explainit-0.1.0.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.0"
  }
}
