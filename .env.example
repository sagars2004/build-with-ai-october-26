# Choose one: gemini, groq, nvidia, or openai.
EXPLAINIT_PROVIDER=groq

# Suggested free-tier-friendly defaults; change the model if your account exposes another one.
EXPLAINIT_MODEL=openai/gpt-oss-20b

# Put exactly one provider key here for local development. Never commit .env.
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=

# Hosted NVIDIA NIM uses https://integrate.api.nvidia.com/v1.
# A local NIM can use http://localhost:8000/v1 instead.
EXPLAINIT_BASE_URL=
